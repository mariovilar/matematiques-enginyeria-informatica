@startuml

title __SRC's Class Diagram__\n


    interface Bird {
        {abstract} + fly()
        {abstract} + molt()
    }

  


    class Eagle {
        ~ currentLocation : String
        ~ numberOfFeathers : int
        + Eagle()
        + fly()
        + molt()
    }

  


    class Penguin {
        ~ currentLocation : String
        ~ numberOfFeathers : int
        + Penguin()
        + fly()
        + molt()
        + swim()
    }

  

  Eagle .up.|> Bird
  Penguin .up.|> Bird


right footer


